{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-scope",
  "type": "object",
  "required": [
    "version",
    "task_id",
    "title",
    "status",
    "source",
    "labels",
    "stack_tags",
    "files_in_scope",
    "files_out_of_scope",
    "acceptance_criteria",
    "implementation_notes",
    "test_commands",
    "review_focus",
    "knowledge_refs"
  ],
  "properties": {
    "version": { "type": "integer" },
    "task_id": { "type": "string" },
    "title": { "type": "string" },
    "status": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["jira_key", "issue_url"],
      "properties": {
        "jira_key": { "type": "string" },
        "issue_url": { "type": "string" }
      },
      "additionalProperties": false
    },
    "labels": { "type": "array", "items": { "type": "string" } },
    "stack_tags": { "type": "array", "items": { "type": "string" } },
    "files_in_scope": { "type": "array", "items": { "type": "string" } },
    "files_out_of_scope": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "implementation_notes": { "type": "array", "items": { "type": "string" } },
    "test_commands": { "type": "array", "items": { "type": "string" } },
    "review_focus": { "type": "array", "items": { "type": "string" } },
    "knowledge_refs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
