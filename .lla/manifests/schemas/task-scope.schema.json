{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-scope",
  "type": "object",
  "required": [
    "version",
    "task_id",
    "title",
    "status",
    "source",
    "labels",
    "stack_tags",
    "files_in_scope",
    "files_out_of_scope",
    "acceptance_criteria",
    "implementation_notes",
    "test_commands",
    "review_focus",
    "knowledge_refs"
  ],
  "properties": {
    "version": { "type": "integer" },
    "task_id": { "type": "string" },
    "title": { "type": "string" },
    "status": { "type": "string" },
    "source": {
      "type": ["object", "null"],
      "required": ["jira_key", "issue_url"],
      "properties": {
        "jira_key": { "type": "string" },
        "issue_url": { "type": "string" }
      },
      "additionalProperties": false,
      "description": "Origem da task. Null quando não há integração com issue tracker (ex.: demanda textual via /sdd-start)."
    },
    "labels": { "type": "array", "items": { "type": "string" } },
    "stack_tags": { "type": "array", "items": { "type": "string" } },
    "files_in_scope": { "type": "array", "items": { "type": "string" } },
    "files_out_of_scope": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "implementation_notes": { "type": "array", "items": { "type": "string" } },
    "test_commands": { "type": "array", "items": { "type": "string" } },
    "review_focus": { "type": "array", "items": { "type": "string" } },
    "knowledge_refs": { "type": "array", "items": { "type": "string" } },
    "inspect_first": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Arquivos a inspecionar antes de implementar"
    },
    "interface_to_implement": {
      "type": "string",
      "description": "Interface ou contrato a implementar, se aplicável"
    },
    "edge_cases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Casos de borda a considerar"
    },
    "tests_to_implement": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Testes a implementar ou verificar"
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Restrições: guardrails, padrões, limites"
    },
    "complexity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "description": "Complexidade estimada da task"
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs de tasks que esta depende"
    },
    "parallelizable": {
      "type": "boolean",
      "description": "Se a task pode ser executada em paralelo com outras"
    }
  },
  "additionalProperties": false
}
