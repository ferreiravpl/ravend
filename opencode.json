{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    "AGENTS.md",
    ".lla/context/*.md",
    ".lla/templates/*.md"
  ],
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".next/**",
      ".turbo/**",
      "target/**",
      ".gradle/**",
      ".idea/**",
      ".vscode/**"
    ]
  },
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {
    "filesystem": {
      "enabled": true
    },
    "jira": {
      "enabled": false
    },
    "github": {
      "enabled": false
    }
  }
}
